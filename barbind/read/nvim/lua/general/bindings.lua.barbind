
-- FUNCTIONS:
local function nsearch(back)
    vim.opt.hlsearch = false
    if back then
        return '?'
    else
        return '/'
    end
end

local function gsearch()
    vim.opt.hlsearch = true
    return ':%s/'
end

local primary = {
    modes = {
        'n',
        'o',
        'p',
    },
    bindings = {
        ["@|~_left_|"] = "h",
        ["@|~_right_|"] = "l",
        ["@|~_up_|"] = "k",
        ["@|~_down_|"] = "j",
        ["@|~_select_|"] = "v",
        ["@|~_new_|"] = "A",
        ["@|~_insert_|"] = "i",
        ["@|~_delete_|"] = '"xx',
        ["@|~_command_|"] = ":",
        ["@|~_up_:~-action-|"] = "<c-u>",
        ["@|~_down_:~-action-|"] = "<c-d>",
    },
    unbindings = {
        "r"
    },
}

for k, v in pairs(primary.bindings) do
    vim.keymap.set(primary.modes, k, v, { noremap = true })
end
for _, v in ipairs(primary.unbindings) do
    vim.keymap.set(primary.modes, v, '<Nop>', {})
end